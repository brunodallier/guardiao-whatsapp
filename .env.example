# Vazio: gera uma chave local persistente em data/session.key.
SESSION_SECRET=
# Ative apenas atrás de HTTPS na futura VPS.
COOKIE_SECURE=false
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SEED_DEMO=true
